<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the macOS app's executables are allowed under Apple's hardened
     runtime, which notarization requires (see scripts/build_macos.sh).
     The same exceptions Qt ships for its WebEngine helper process:
     Chromium compiles JavaScript at run time (JIT), which the hardened
     runtime otherwise forbids. Applied to every executable in the bundle,
     since the Python that runs the app and loads Qt is one of them. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-executable-page-protection</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
